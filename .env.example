# Variables de entorno de VIAO — plantilla sin valores reales.
# Copiar a .env.local (ignorado por Git) y rellenar con las credenciales reales.
# Ver docs/VIAO_ARCHITECTURE.md, sección 22 (Gestión de secretos y variables de entorno).

# Supabase (Fase 1) — públicas, seguras de exponer al cliente.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — privada, solo backend. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (Fase 9 — VIAO AI / Fase 10 — VIAO Vision) — privada, solo backend.
OPENAI_API_KEY=

# F9-01/F9-05 (VIAO_ROADMAP.md) — configuración del wrapper lib/openai/,
# todas opcionales/provisionales (ver lib/openai/config.ts para los
# valores por defecto si se omiten).
# Modelo usado por generateSearchRecommendation(). Por defecto: gpt-4o-mini.
OPENAI_MODEL=
# Timeout en milisegundos para cada llamada a OpenAI. Por defecto: 15000.
OPENAI_TIMEOUT_MS=
# Interruptor de emergencia (F9-05). Fail-closed: cualquier valor distinto
# de la cadena exacta "true" deshabilita VIAO AI (ningún coste de OpenAI).
AI_RECOMMENDATIONS_ENABLED=

# Hotelbeds — prueba de conexión sandbox (lib/hotelbeds/), privadas, solo
# backend. HOTELBEDS_BASE_URL debe apuntar siempre a un entorno explícito
# (test o live) — no tiene valor por defecto, para que sea imposible
# apuntar a LIVE por accidente si se omite. Para desarrollo, usar el
# sandbox: https://api.test.hotelbeds.com
HOTELBEDS_API_KEY=
HOTELBEDS_SECRET=
HOTELBEDS_BASE_URL=
# Certificado cliente (mTLS) asociado a la Hotel API Key en el dashboard
# de Hotelbeds — rutas a archivos locales, nunca el contenido. Ninguna de
# las dos tiene valor por defecto (mismo motivo que HOTELBEDS_BASE_URL).
HOTELBEDS_CLIENT_CERT_PATH=
HOTELBEDS_CLIENT_KEY_PATH=

# Selector de provider (lib/travel-provider/index.ts) — fail-safe:
# ausente, vacío o cualquier valor distinto de "hotelbeds" -> Mock.
# Activar HotelbedsProvider en este punto del proyecto rompe
# Properties/Booking (getDetails/book sin implementar todavía) — solo
# para pruebas controladas de Search, nunca poner "hotelbeds" en
# producción sin haber completado el resto de la integración.
TRAVEL_PROVIDER=
# Códigos de hotel Hotelbeds explícitos, separados por comas (p. ej.
# "3424,168" — los 2 ya verificados con una petición real), solo
# relevante si TRAVEL_PROVIDER=hotelbeds. Sin esta variable, search()
# sigue fallando con un error explícito (destino->código sin resolver)
# en vez de inventar un código.
HOTELBEDS_FIXED_HOTEL_CODES=

# PostHog (Fase 12 — Analytics) — públicas, seguras de exponer al cliente:
# la "project API key" de PostHog es de solo-ingesta por diseño, ver
# lib/analytics/posthog.ts. Sin estas dos variables, PostHog queda
# deshabilitado (no-op) y VIAO sigue funcionando con normalidad.
NEXT_PUBLIC_POSTHOG_KEY=
# Por defecto (si se omite): https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=
